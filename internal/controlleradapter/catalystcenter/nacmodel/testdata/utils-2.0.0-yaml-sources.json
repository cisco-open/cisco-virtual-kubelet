[
  {
    "name": "anchors",
    "inputs": [
      "catalyst_center: {sites: {base: &a {x: 1}, copy: *a}}"
    ],
    "env": {
      "CVK_ORACLE_VALUE": "true"
    },
    "expected": {
      "catalyst_center": {
        "sites": {
          "base": {
            "x": 1
          },
          "copy": {
            "x": 1
          }
        }
      }
    },
    "error": false
  },
  {
    "name": "merge-before-explicit",
    "inputs": [
      "catalyst_center: {sites: {base: &a {x: 1, y: 2}, value: {<<: *a, x: 3}}}"
    ],
    "env": {
      "CVK_ORACLE_VALUE": "true"
    },
    "expected": {
      "catalyst_center": {
        "sites": {
          "base": {
            "x": 1,
            "y": 2
          },
          "value": {
            "x": 3,
            "y": 2
          }
        }
      }
    },
    "error": false
  },
  {
    "name": "merge-after-explicit",
    "inputs": [
      "catalyst_center: {sites: {base: &a {x: 1, y: 2}, value: {x: 3, <<: *a}}}"
    ],
    "env": {
      "CVK_ORACLE_VALUE": "true"
    },
    "expected": {
      "catalyst_center": {
        "sites": {
          "base": {
            "x": 1,
            "y": 2
          },
          "value": {
            "x": 3,
            "y": 2
          }
        }
      }
    },
    "error": false
  },
  {
    "name": "merge-only",
    "inputs": [
      "catalyst_center: {sites: {base: &a {x: 1}, value: {<<: *a}}}"
    ],
    "env": {
      "CVK_ORACLE_VALUE": "true"
    },
    "expected": {
      "catalyst_center": {
        "sites": {
          "base": {
            "x": 1
          },
          "value": {
            "x": 1
          }
        }
      }
    },
    "error": false
  },
  {
    "name": "merge-list",
    "inputs": [
      "catalyst_center: {sites: {a: &a {x: 1}, b: &b {x: 2, y: 3}, value: {<<: [*a, *b], z: 4}}}"
    ],
    "env": {
      "CVK_ORACLE_VALUE": "true"
    },
    "expected": {
      "catalyst_center": {
        "sites": {
          "a": {
            "x": 1
          },
          "b": {
            "x": 2,
            "y": 3
          },
          "value": {
            "x": 1,
            "y": 3,
            "z": 4
          }
        }
      }
    },
    "error": false
  },
  {
    "name": "str-octal",
    "inputs": [
      "catalyst_center: {sites: {value: !!str 010}}"
    ],
    "env": {
      "CVK_ORACLE_VALUE": "true"
    },
    "expected": {
      "catalyst_center": {
        "sites": {
          "value": "8"
        }
      }
    },
    "error": false
  },
