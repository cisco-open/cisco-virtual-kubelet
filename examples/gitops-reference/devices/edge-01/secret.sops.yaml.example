# PLACEHOLDER — not a usable Secret. Do not apply this file.
#
# In your own fork, replace the body below with a real SOPS-encrypted
# Kubernetes Secret using an age or PGP recipient your cluster's
# Flux controller can decrypt. The unencrypted shape must be:
#
#   apiVersion: v1
#   kind: Secret
#   metadata:
#     name: edge-01-creds
#     namespace: network
#   type: Opaque
#   stringData:
#     password: <device-password>
#
# Keep the ".example" suffix on THIS file so the upstream repository
# never accidentally carries a real credential — even a SOPS-encrypted
# one, since the encryption assumptions differ between installations.
apiVersion: v1
kind: Secret
metadata:
  name: edge-01-creds
  namespace: network
stringData:
  password: REPLACE_ME_WITH_A_SOPS_ENCRYPTED_VALUE
