    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Per-app CPU / memory / disk / vcpu reservation and CPU utilization. Each row is one (app, metric) tuple sourced from /Cisco-IOS-XE-app-hosting-oper:app-hosting-oper-data/app-hosting-list.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "left"
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 120,
      "options": {
        "showHeader": true
      },
      "pluginVersion": "13.0.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(40, avg by (__name__) (last_over_time({__name__=~\"cvk_app_hosting_app_name_.*_(details_resource_reservation_(cpu|memory|disk|vcpu|cpu_percent)|utilization_cpu_util_(actual|requested)_application_util)$\"}[10m])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "service_name": true,
              "instance": true,
              "job": true,
              "exported_job": true,
              "otel_scope_name": true,
              "telemetry_sdk_language": true,
              "telemetry_sdk_name": true,
              "telemetry_sdk_version": true,
              "smoke_run": true,
              "env": true,
              "cluster": true,
              "owner": true,
              "cisco_device_address": true,
              "cisco_device_driver": true,
              "service_namespace": true
            },
            "renameByName": {
              "Value": "value"
            }
          }
        }
      ],
      "title": "App resource snapshot \u2014 per app reservations and utilization",
      "type": "table"
    },
