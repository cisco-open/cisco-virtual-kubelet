{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cisco-virtual-kubelet Helm values",
  "description": "Validates `helm install --set` and `-f values.yaml` invocations so a typo'd key name fails fast at install time instead of silently no-op'ing. Every field listed in values.yaml has a schema entry here; additionalProperties=false enforces that.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "serviceAccount", "controller"],
  "allOf": [
    {
      "if": {
        "required": ["topology"],
        "properties": {
          "topology": {
            "required": ["enabled"],
            "properties": { "enabled": { "const": true } }
          }
        }
      },
      "then": {
        "properties": {
          "controller": {
            "properties": { "leaderElect": { "const": true } }
          },
          "gnoi": {
            "properties": { "enableWriteClass": { "const": false } }
          }
        }
      }
    }
  ],
  "definitions": {
    "workerResourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "$ref": "#/definitions/workerQuantity" },
        "memory": { "$ref": "#/definitions/workerQuantity" },
        "ephemeral-storage": { "$ref": "#/definitions/workerQuantity" }
      }
    },
    "workerQuantity": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+|[EPTGMK]i|[numkMGTPE])?$" }
      ]
    },
    "topologyKey": {
      "type": "string",
      "maxLength": 85,
      "pattern": "^(topology\\.kubernetes\\.io/(region|zone)|(topology|operations|distribution)\\.cisco\\.vk/[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)$"
    },
    "projectedTopologyKey": {
      "type": "string",
      "maxLength": 81,
      "pattern": "^(topology\\.kubernetes\\.io/(region|zone)|topology\\.cisco\\.vk/[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)$"
    },
    "dnsSubdomainOrEmpty": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
    },
    "dnsLabelOrEmpty": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "managedFleetSelectorKey": {
      "type": "string",
      "maxLength": 81,
      "pattern": "^topology\\.cisco\\.vk/[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "controllerImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["", "Always", "IfNotPresent", "Never"]
        }
      }
    },
    "vkImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["", "Always", "IfNotPresent", "Never"]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Controller replicas; leader election arbitrates if >1."
    },
    "nameOverride":     { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controllerName", "vkName"],
      "properties": {
        "controllerName": { "type": "string", "minLength": 1 },
        "vkName":         { "type": "string", "minLength": 1 }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["default", "strict"],
          "description": "default preserves the historical VK role; strict trims reserved/high-risk permissions unless their runtime gates are enabled."
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaderElect", "metricsBindAddress", "healthProbeBindAddress"],
      "properties": {
        "leaderElect":            { "type": "boolean" },
        "metricsBindAddress":     {
          "type": "string",
          "pattern": "^([a-zA-Z0-9.-]*):[0-9]+$",
          "description": "host:port — empty host means all interfaces"
        },
        "healthProbeBindAddress": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9.-]*):[0-9]+$"
        }
      }
    },
    "aggregator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Run in-process per-device ConfigReconcilers instead of spawning one cisco-vk pod per CiscoDevice. Default false preserves the per-pod topology."
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "policy", "ledger"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable manager-owned topology and rollout admission. Requires Kubernetes 1.35 or newer, aggregator.enabled=false, controller.leaderElect=true, serviceAccount.vkName=cisco-virtual-kubelet, rbac.profile=strict, and gnoi.enableWriteClass=false. Migrating an existing release requires live Helm lookup; offline GitOps pruning is unsupported for the one-time shared-worker handoff."
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "name",
            "fleetSelector",
            "requiredTopologyKeys",
            "projectedTopologyKeys",
            "globalMaxConcurrentTransfers",
            "globalMaxUnavailable",
            "domainMaxConcurrentTransfers",
            "domainMaxUnavailable",
            "healthFreshnessSeconds",
            "maxCampaignTargets",
            "maxActiveReservations",
            "maxLedgerBytes"
          ],
          "properties": {
            "namespace": { "$ref": "#/definitions/dnsLabelOrEmpty" },
            "name": { "$ref": "#/definitions/dnsSubdomainOrEmpty" },
            "fleetSelector": {
              "type": "object",
              "additionalProperties": false,
              "required": ["matchLabels", "matchExpressions"],
              "anyOf": [
                { "properties": { "matchLabels": { "minProperties": 1 } } },
                { "properties": { "matchExpressions": { "minItems": 1 } } }
              ],
              "properties": {
                "matchLabels": {
                  "type": "object",
                  "maxProperties": 32,
                  "propertyNames": { "$ref": "#/definitions/managedFleetSelectorKey" },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 63,
                    "pattern": "^$|^[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
                  }
                },
                "matchExpressions": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["key", "operator"],
                    "allOf": [
                      {
                        "if": { "properties": { "operator": { "enum": ["In", "NotIn"] } } },
                        "then": {
                          "required": ["values"],
                          "properties": { "values": { "minItems": 1 } }
                        }
                      },
                      {
                        "if": { "properties": { "operator": { "enum": ["Exists", "DoesNotExist"] } } },
                        "then": { "properties": { "values": { "maxItems": 0 } } }
                      }
                    ],
                    "properties": {
                      "key": { "$ref": "#/definitions/managedFleetSelectorKey" },
                      "operator": { "type": "string", "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
                      "values": {
                        "type": "array",
                        "maxItems": 32,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "maxLength": 63,
                          "pattern": "^$|^[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
                        }
                      }
                    }
                  }
                }
              }
            },
            "requiredTopologyKeys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/topologyKey" }
            },
            "projectedTopologyKeys": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/projectedTopologyKey" }
            },
            "globalMaxConcurrentTransfers": { "type": "integer", "minimum": 1, "maximum": 100 },
            "globalMaxUnavailable": { "type": "integer", "minimum": 1, "maximum": 100 },
            "domainMaxConcurrentTransfers": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 16,
              "propertyNames": { "$ref": "#/definitions/topologyKey" },
              "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 100 }
            },
            "domainMaxUnavailable": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 16,
              "propertyNames": { "$ref": "#/definitions/topologyKey" },
              "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 100 }
            },
            "healthFreshnessSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
            "maxCampaignTargets": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maxActiveReservations": { "type": "integer", "minimum": 1, "maximum": 256 },
            "maxLedgerBytes": { "type": "integer", "minimum": 4096, "maximum": 262144 }
          }
        },
        "ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "$ref": "#/definitions/dnsSubdomainOrEmpty" }
          }
        }
      }
    },
    "nxos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowExperimentalReleases"],
      "properties": {
        "allowExperimentalReleases": {
          "type": "boolean",
          "description": "Opt in to NX-OS profiles backed by static conformance evidence but not yet qualified by CVK live write testing."
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["otlp", "yangModelsDir", "yangModels", "resourceAttributes"],
      "properties": {
        "otlp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "insecure", "headers"],
          "properties": {
            "endpoint": { "type": "string" },
            "insecure": { "type": "boolean" },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "headersSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "description": "When name is non-empty the chart wires OTEL_EXPORTER_OTLP_HEADERS via a SecretKeyRef and the controller mirrors that ref onto every per-device VK pod (operators must replicate the Secret to each device.Namespace). Use this instead of inline headers when the value contains auth tokens.",
              "properties": {
                "name": { "type": "string" },
                "key":  { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "yangModelsDir": { "type": "string" },
        "yangModels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configMapName", "mountPath"],
          "properties": {
            "configMapName": { "type": "string" },
            "mountPath":     { "type": "string" }
          }
        },
        "resourceAttributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "gnoi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["insecure", "port", "disabled", "enableSoftwareUpgrade", "softwareUpgrade", "enableWriteClass"],
      "properties": {
        "insecure": {
          "type": "boolean",
          "description": "Force legacy, non-opt-in IOS-XE devices onto the insecure gnxi/gNOI listener. Explicit spec.gnoi.transportSecurity=tls rejects this downgrade."
        },
        "port": {
          "description": "Optional device-side gNOI listener port. Empty lets CVK infer 50052 for insecure or 9339 for secure.",
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "pattern": "^(?:|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$" }
          ]
        },
        "disabled": {
          "type": "boolean",
          "description": "Disable the per-device gNOI client even when the binary includes gNOI support."
        },
        "enableSoftwareUpgrade": {
          "type": "boolean",
          "description": "Enable the IOSXESoftwareUpgrade gNOI OS install/activate reconciler on per-device VK pods."
        },
        "softwareUpgrade": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxImageBytes"],
          "properties": {
            "maxImageBytes": {
              "type": "integer",
              "minimum": 1,
              "description": "Hard per-image byte limit for URL and ConfigMap software-upgrade sources; rendered as CISCO_VK_UPGRADE_MAX_IMAGE_BYTES."
            }
          }
        },
        "enableWriteClass": {
          "type": "boolean",
          "description": "Enable write-class IOSXEOperationalAction gNOI operations such as Reboot, FactoryReset, FilePut, FileRemove, and ProvisionCertificate; certificate provisioning can replace IOS-XE's shared gNXI/gNMI identity and CA bundle. Must remain false while managed topology is enabled because Phase 2 admits campaign-owned IOSXESoftwareUpgrade only."
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "global": { "type": "object" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaseNamespace": {
          "type": "string",
          "description": "Storage namespace for per-(device, family) config and disruptive-mutation arbitration leases. Empty uses each worker's pod/device namespace."
        },
        "yangValidationMode": {
          "type": "string",
          "enum": ["disabled", "warn", "strict"],
          "description": "Controls IOS-XE NetAsCode-to-YANG operation validation before config mutations."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits":   { "type": "object" },
        "requests": { "type": "object" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": { "$ref": "#/definitions/workerResourceList" },
            "limits": { "$ref": "#/definitions/workerResourceList" }
          }
        },
        "tmpSizeLimit": {
          "type": "string",
          "pattern": "^$|^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+|[EPTGMK]i|[numkMGTPE])?$",
          "not": { "pattern": "^0+(\\.0+)?([eE][+-]?[0-9]+|[EPTGMK]i|[numkMGTPE])?$" },
          "description": "Positive Kubernetes quantity limiting each worker's disk-backed /tmp; empty preserves the unbounded default."
        }
      }
    },
    "nodeSelector":   { "type": "object" },
    "tolerations":    { "type": "array" },
    "affinity":       { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels":      { "type": "object" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":        { "type": "boolean" },
        "minAvailable":   { "type": ["string", "integer"] },
        "maxUnavailable": { "type": ["string", "integer"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Configure a controller-pod NetworkPolicy. This does not select dynamically created per-device VK pods, which require separate policies.",
      "properties": {
        "enabled":      { "type": "boolean" },
        "deviceCIDRs":  { "type": "array", "description": "Controller egress CIDRs allowed on the chart's fixed management ports; custom ports and per-device workers require separate policy rules.", "items": { "type": "string" } },
        "scraperCIDRs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":           { "type": "boolean" },
        "interval":          { "type": "string" },
        "scrapeTimeout":     { "type": "string" },
        "labels":            { "type": "object" },
        "relabelings":       { "type": "array" },
        "metricRelabelings": { "type": "array" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 },
        "seccompProfile": { "type": "object" }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "capabilities": { "type": "object" },
        "readOnlyRootFilesystem": { "type": "boolean" }
      }
    }
  }
}
