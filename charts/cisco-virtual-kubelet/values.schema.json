{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cisco-virtual-kubelet Helm values",
  "description": "Validates `helm install --set` and `-f values.yaml` invocations so a typo'd key name fails fast at install time instead of silently no-op'ing. Every field listed in values.yaml has a schema entry here; additionalProperties=false enforces that.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "serviceAccount", "controller"],
  "definitions": {
    "workerResourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "$ref": "#/definitions/workerQuantity" },
        "memory": { "$ref": "#/definitions/workerQuantity" },
        "ephemeral-storage": { "$ref": "#/definitions/workerQuantity" }
      }
    },
    "workerQuantity": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+|[EPTGMK]i|[numkMGTPE])?$" }
      ]
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "controllerImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["", "Always", "IfNotPresent", "Never"]
        }
      }
    },
    "vkImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["", "Always", "IfNotPresent", "Never"]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Controller replicas; leader election arbitrates if >1."
    },
    "nameOverride":     { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controllerName", "vkName"],
      "properties": {
        "controllerName": { "type": "string", "minLength": 1 },
        "vkName":         { "type": "string", "minLength": 1 }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["default", "strict"],
          "description": "default preserves the historical VK role; strict trims reserved/high-risk permissions unless their runtime gates are enabled."
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaderElect", "metricsBindAddress", "healthProbeBindAddress"],
      "properties": {
        "leaderElect":            { "type": "boolean" },
        "metricsBindAddress":     {
          "type": "string",
          "pattern": "^([a-zA-Z0-9.-]*):[0-9]+$",
          "description": "host:port — empty host means all interfaces"
        },
        "healthProbeBindAddress": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9.-]*):[0-9]+$"
        }
      }
    },
    "aggregator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Run in-process per-device ConfigReconcilers instead of spawning one cisco-vk pod per CiscoDevice. Default false preserves the per-pod topology."
        }
      }
    },
    "nxos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowExperimentalReleases"],
      "properties": {
        "allowExperimentalReleases": {
          "type": "boolean",
          "description": "Opt in to NX-OS profiles backed by static conformance evidence but not yet qualified by CVK live write testing."
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["otlp", "yangModelsDir", "yangModels", "resourceAttributes"],
      "properties": {
        "otlp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "insecure", "headers"],
          "properties": {
            "endpoint": { "type": "string" },
            "insecure": { "type": "boolean" },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "headersSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "description": "When name is non-empty the chart wires OTEL_EXPORTER_OTLP_HEADERS via a SecretKeyRef and the controller mirrors that ref onto every per-device VK pod (operators must replicate the Secret to each device.Namespace). Use this instead of inline headers when the value contains auth tokens.",
              "properties": {
                "name": { "type": "string" },
                "key":  { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "yangModelsDir": { "type": "string" },
        "yangModels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configMapName", "mountPath"],
          "properties": {
            "configMapName": { "type": "string" },
            "mountPath":     { "type": "string" }
          }
        },
        "resourceAttributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "gnoi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["insecure", "port", "disabled", "enableSoftwareUpgrade", "softwareUpgrade", "enableWriteClass"],
      "properties": {
        "insecure": {
          "type": "boolean",
          "description": "Force legacy, non-opt-in IOS-XE devices onto the insecure gnxi/gNOI listener. Explicit spec.gnoi.transportSecurity=tls rejects this downgrade."
        },
        "port": {
          "description": "Optional device-side gNOI listener port. Empty lets CVK infer 50052 for insecure or 9339 for secure.",
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "pattern": "^(?:|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$" }
          ]
        },
        "disabled": {
          "type": "boolean",
          "description": "Disable the per-device gNOI client even when the binary includes gNOI support."
        },
        "enableSoftwareUpgrade": {
          "type": "boolean",
          "description": "Enable the IOSXESoftwareUpgrade gNOI OS install/activate reconciler on per-device VK pods."
        },
        "softwareUpgrade": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxImageBytes"],
          "properties": {
            "maxImageBytes": {
              "type": "integer",
              "minimum": 1,
              "description": "Hard per-image byte limit for URL and ConfigMap software-upgrade sources; rendered as CISCO_VK_UPGRADE_MAX_IMAGE_BYTES."
            }
          }
        },
        "enableWriteClass": {
          "type": "boolean",
          "description": "Enable write-class IOSXEOperationalAction gNOI operations such as Reboot, FactoryReset, FilePut, FileRemove, and ProvisionCertificate; certificate provisioning can replace IOS-XE's shared gNXI/gNMI identity and CA bundle."
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "global": { "type": "object" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaseNamespace": {
          "type": "string",
          "description": "Storage namespace for per-(device, family) config and disruptive-mutation arbitration leases. Empty uses each worker's pod/device namespace."
        },
        "yangValidationMode": {
          "type": "string",
          "enum": ["disabled", "warn", "strict"],
          "description": "Controls IOS-XE NetAsCode-to-YANG operation validation before config mutations."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits":   { "type": "object" },
        "requests": { "type": "object" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": { "$ref": "#/definitions/workerResourceList" },
            "limits": { "$ref": "#/definitions/workerResourceList" }
          }
        },
        "tmpSizeLimit": {
          "type": "string",
          "pattern": "^$|^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+|[EPTGMK]i|[numkMGTPE])?$",
          "not": { "pattern": "^0+(\\.0+)?([eE][+-]?[0-9]+|[EPTGMK]i|[numkMGTPE])?$" },
          "description": "Positive Kubernetes quantity limiting each worker's disk-backed /tmp; empty preserves the unbounded default."
        }
      }
    },
    "nodeSelector":   { "type": "object" },
    "tolerations":    { "type": "array" },
    "affinity":       { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels":      { "type": "object" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":        { "type": "boolean" },
        "minAvailable":   { "type": ["string", "integer"] },
        "maxUnavailable": { "type": ["string", "integer"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Configure a controller-pod NetworkPolicy. This does not select dynamically created per-device VK pods, which require separate policies.",
      "properties": {
        "enabled":      { "type": "boolean" },
        "deviceCIDRs":  { "type": "array", "description": "Controller egress CIDRs allowed on the chart's fixed management ports; custom ports and per-device workers require separate policy rules.", "items": { "type": "string" } },
        "scraperCIDRs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":           { "type": "boolean" },
        "interval":          { "type": "string" },
        "scrapeTimeout":     { "type": "string" },
        "labels":            { "type": "object" },
        "relabelings":       { "type": "array" },
        "metricRelabelings": { "type": "array" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 },
        "seccompProfile": { "type": "object" }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "capabilities": { "type": "object" },
        "readOnlyRootFilesystem": { "type": "boolean" }
      }
    }
  }
}
