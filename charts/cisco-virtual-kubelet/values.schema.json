{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cisco-virtual-kubelet Helm values",
  "description": "Validates `helm install --set` and `-f values.yaml` invocations so a typo'd key name fails fast at install time instead of silently no-op'ing. Every field listed in values.yaml has a schema entry here; additionalProperties=false enforces that.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "serviceAccount", "controller"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "controllerImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["", "Always", "IfNotPresent", "Never"]
        }
      }
    },
    "vkImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["", "Always", "IfNotPresent", "Never"]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Controller replicas; leader election arbitrates if >1."
    },
    "nameOverride":     { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controllerName", "vkName"],
      "properties": {
        "controllerName": { "type": "string", "minLength": 1 },
        "vkName":         { "type": "string", "minLength": 1 }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaderElect", "metricsBindAddress", "healthProbeBindAddress"],
      "properties": {
        "leaderElect":            { "type": "boolean" },
        "metricsBindAddress":     {
          "type": "string",
          "pattern": "^([a-zA-Z0-9.-]*):[0-9]+$",
          "description": "host:port — empty host means all interfaces"
        },
        "healthProbeBindAddress": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9.-]*):[0-9]+$"
        }
      }
    },
    "aggregator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Run in-process per-device ConfigReconcilers instead of spawning one cisco-vk pod per CiscoDevice. Default false preserves the per-pod topology."
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["otlp", "yangModelsDir", "yangModels", "resourceAttributes"],
      "properties": {
        "otlp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "insecure", "headers"],
          "properties": {
            "endpoint": { "type": "string" },
            "insecure": { "type": "boolean" },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "headersSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "description": "When name is non-empty the chart wires OTEL_EXPORTER_OTLP_HEADERS via a SecretKeyRef and the controller mirrors that ref onto every per-device VK pod (operators must replicate the Secret to each device.Namespace). Use this instead of inline headers when the value contains auth tokens.",
              "properties": {
                "name": { "type": "string" },
                "key":  { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "yangModelsDir": { "type": "string" },
        "yangModels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configMapName", "mountPath"],
          "properties": {
            "configMapName": { "type": "string" },
            "mountPath":     { "type": "string" }
          }
        },
        "resourceAttributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "gnoi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["insecure", "port", "disabled", "enableSoftwareUpgrade", "enableWriteClass"],
      "properties": {
        "insecure": {
          "type": "boolean",
          "description": "Force CVK to dial the insecure IOS-XE gnxi/gNOI listener instead of inferring TLS from the CiscoDevice transport."
        },
        "port": {
          "type": ["string", "integer"],
          "description": "Optional device-side gNOI listener port. Empty lets CVK infer 50052 for insecure or 9339 for secure."
        },
        "disabled": {
          "type": "boolean",
          "description": "Disable the per-device gNOI client even when the binary includes gNOI support."
        },
        "enableSoftwareUpgrade": {
          "type": "boolean",
          "description": "Enable the IOSXESoftwareUpgrade gNOI OS install/activate reconciler on per-device VK pods."
        },
        "enableWriteClass": {
          "type": "boolean",
          "description": "Enable write-class IOSXEOperationalAction gNOI operations such as Reboot, FactoryReset, FilePut, and FileRemove."
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "global": { "type": "object" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaseNamespace": {
          "type": "string",
          "description": "Shared namespace for per-(device, family) arbitration leases. Empty falls back to per-pod-namespace behaviour."
        },
        "yangValidationMode": {
          "type": "string",
          "enum": ["disabled", "warn", "strict"],
          "description": "Controls IOS-XE NetAsCode-to-YANG operation validation before config mutations."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits":   { "type": "object" },
        "requests": { "type": "object" }
      }
    },
    "nodeSelector":   { "type": "object" },
    "tolerations":    { "type": "array" },
    "affinity":       { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels":      { "type": "object" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":        { "type": "boolean" },
        "minAvailable":   { "type": ["string", "integer"] },
        "maxUnavailable": { "type": ["string", "integer"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":      { "type": "boolean" },
        "deviceCIDRs":  { "type": "array", "items": { "type": "string" } },
        "scraperCIDRs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":           { "type": "boolean" },
        "interval":          { "type": "string" },
        "scrapeTimeout":     { "type": "string" },
        "labels":            { "type": "object" },
        "relabelings":       { "type": "array" },
        "metricRelabelings": { "type": "array" }
      }
    }
  }
}
